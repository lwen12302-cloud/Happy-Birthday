from PIL import Image
import matplotlib.pyplot as plt
import numpy as np

def image_to_matrix(image_path, size=(50, 50)):
    img = Image.open(image_path).convert('RGB') # 确保是 RGB 模式
    img = img.resize(size, Image.NEAREST)
    plt.imshow(img)
    plt.show()
    
    data = np.array(img)
    
    hex_matrix = []
    for row in data:
        hex_row = []
        for pixel in row:
            # 将 [R, G, B] 转换为 #RRGGBB 格式
            # :02x 表示转为16进制，两位数，不足补0
            hex_color = "#{:02x}{:02x}{:02x}".format(pixel[0], pixel[1], pixel[2])
            hex_row.append(hex_color)
        hex_matrix.append(hex_row)
        
    return hex_matrix

matrix = image_to_matrix("l.jpg", size=(40, 40))

with open("2.txt", 'w', encoding='utf-8') as f:
    f.write(str(matrix))
print(f"第一个像素的结构: {matrix[0]}")
